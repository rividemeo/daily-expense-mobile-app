{
  "expo": {
    "name": "ExpenseFlow",
    "slug": "expense-flow",
    "version": "1.0.0",
    "scheme": "expenseflow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1565C0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expenseflow.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow ExpenseFlow to access your photo library to attach receipts to transactions.",
        "NSCameraUsageDescription": "Allow ExpenseFlow to use your camera to capture receipt photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#1565C0",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.expenseflow.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ExpenseFlow to access your photos to attach receipts.",
          "cameraPermission": "Allow ExpenseFlow to use your camera to scan receipts."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
